# Porta publicada no computador. Dentro do container a app escuta sempre em 3000.
HOST_PORT=3000

# WhatsApp Cloud API (Meta)
# Token permanente do usuário do sistema. Meta Business > Usuários do sistema.
WHATSAPP_TOKEN=

# ID do número na API. Não é o telefone. WhatsApp > API Setup > Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=

# ID da conta WhatsApp Business (WABA). WhatsApp > API Setup.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# App Secret do app Meta. Valida o header X-Hub-Signature-256 do webhook.
WHATSAPP_APP_SECRET=

# Texto que você inventa e cola igual no campo Verify token do webhook da Meta.
WHATSAPP_VERIFY_TOKEN=

# Número que as pessoas vão mandar mensagem, em E.164. Só aparece no painel.
WHATSAPP_DISPLAY_PHONE_NUMBER=

# Opcional. Versão da Graph API.
WHATSAPP_API_VERSION=v23.0

# URL pública HTTPS do servidor, sem barra no final. A Meta chama {URL}/webhook.
WEBHOOK_PUBLIC_URL=

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
