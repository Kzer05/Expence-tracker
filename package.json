{
  "name": "wa-expense-tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "WhatsApp expense tracker using the Meta Cloud API, AI, and Supabase",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
