    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.47.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "openai": "^4.78.1"
  }
}
